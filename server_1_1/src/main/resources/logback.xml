<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- ============ APPENDERS ============ -->

    <!-- Сводка одиночного бенчмарка -->
    <appender name="SUMMARY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger
                message = %msg
                max = %X{maxRTT_ms} ms
                min = %X{minRTT_ms} ms
                total = %X{totalRTT_ms} ms
                avg = %X{averageRTT_ms} ms
                p95 = %X{p95_ms} ms%n</pattern>
        </encoder>
    </appender>

    <!-- Каждый запрос одиночного бенчмарка -->
    <appender name="REQUEST" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger
                message = %msg
                start = %X{startTime_ms} ms
                end = %X{endTime_ms} ms
                rtt = %X{rtt_ms} ms
                server_time = %X{serverTime_s} s%n%n</pattern>
        </encoder>
    </appender>

    <!-- Сводка параллельного бенчмарка -->
    <appender name="PARALLEL_SUMMARY" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger
                message = %msg
                clients = %X{clients}
                messages_per_client = %X{messagesPerClient}
                total_messages = %X{totalMessages}
                wall_time = %X{wallTime_ms} ms
                throughput = %X{throughput_msgPerSec} msg/s
                total = %X{totalRTT_ms} ms
                avg = %X{averageRTT_ms} ms
                min = %X{minRTT_ms} ms
                max = %X{maxRTT_ms} ms
                p95 = %X{p95RTT_ms} ms%n%n</pattern>
        </encoder>
    </appender>

    <!-- Каждый запрос параллельного бенчмарка -->
    <appender name="PARALLEL_REQUEST" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger
                message = %msg
                client = %X{clientId}
                start = %X{startTime_ms} ms
                end = %X{endTime_ms} ms
                rtt = %X{rtt_ms} ms
                server_time = %X{serverTime_s} s%n%n</pattern>
        </encoder>
    </appender>

    <!-- Ответ сервера на каждое эхо-сообщение -->
    <appender name="SERVER_RESPONSE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger
                message = %msg
                remote = %X{remote}
                thread = %X{thread}%n%n</pattern>
        </encoder>
    </appender>

    <!-- Всё остальное -->
    <appender name="DEFAULT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger -- %msg%n</pattern>
        </encoder>
    </appender>

    <!-- ============ LOGGERS ============ -->

    <logger name="Benchmark.Summary" level="INFO" additivity="false">
        <appender-ref ref="SUMMARY"/>
    </logger>

    <logger name="Benchmark.Request" level="INFO" additivity="false">
        <appender-ref ref="REQUEST"/>
    </logger>

    <logger name="Benchmark.Parallel.Summary" level="INFO" additivity="false">
        <appender-ref ref="PARALLEL_SUMMARY"/>
    </logger>

    <logger name="Benchmark.Parallel.Request" level="INFO" additivity="false">
        <appender-ref ref="PARALLEL_REQUEST"/>
    </logger>

    <logger name="Benchmark.Server.Response" level="INFO" additivity="false">
        <appender-ref ref="SERVER_RESPONSE"/>
    </logger>

    <!-- ============ ROOT ============ -->

    <root level="INFO">
        <appender-ref ref="DEFAULT"/>
    </root>

</configuration>