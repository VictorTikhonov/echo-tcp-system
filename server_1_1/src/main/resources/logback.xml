<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <appender name="SERVER_RESPONSE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger
                message = %msg
                remote = %X{remote}
                thread = %X{thread}%n%n</pattern>
        </encoder>
    </appender>

    <appender name="DEFAULT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger -- %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="ru.tikhonov.task_1.TcpServer" level="WARN"/>

    <logger name="ru.tikhonov.task_3.GrpcServer" level="WARN"/>

    <logger name="Benchmark.Server.Response" level="WARN" additivity="false">
        <appender-ref ref="SERVER_RESPONSE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="DEFAULT"/>
    </root>

</configuration>